# Default-deny build context: include only runtime sources and assets.
**
!Dockerfile
!.dockerignore
!requirements.txt
!app.py
!config.py
!web_app.py
!initialize_database.py
!database/
!database/**
!importers/
!importers/**
!scheduling/
!scheduling/**
!services/
!services/**
!web/
!web/**
!main_workflow/
!main_workflow/**
!flow_test/
!flow_test/**
!demo/
!demo/parent_responses.json
!demo/parent_responses_large.json

# Exclusions take priority even inside included runtime directories.
**/.env
**/.env.*
**/*.local
**/*.local.*
**/secrets
**/credentials.json
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.token
**/__pycache__
**/*.py[cod]
**/.git
**/.venv
**/venv
**/node_modules
**/data
**/output
**/outputs
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite-*
**/*.sqlite3
**/*.sqlite3-*
**/*.csv
**/*.tsv
**/*.xls
**/*.xlsx
**/*.xlsm
**/*.xlsb
**/*.docx
**/*.pdf
**/*.log
**/*.bak
**/*.backup
**/*.tmp
**/*.temp
**/*.zip
**/*.tar
**/*.gz
**/*.md
**/*.ps1
**/zoho_records.json
**/records.json
