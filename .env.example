# Copy this file to .env, then enter your own values. Never commit .env.

# Azure PostgreSQL (optional; omit to use the local SQLite database)
# THERAPY_SCHEDULER_DATABASE_URL=postgresql+psycopg://<user>:<url-encoded-password>@<server>:5432/postgres?sslmode=require

# WhatsApp Cloud API. Set the values as Azure Container App secrets in
# production; do not commit actual values. The template and recipient settings
# are only used by the backend-only test command.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=v26.0
# Total attempts include the first send. Shared by main and test workers.
WHATSAPP_MAX_SEND_ATTEMPTS=5
WHATSAPP_RETRY_BASE_SECONDS=30
WHATSAPP_DELIVERY_ALERT_MINUTES=15
# Web processes queue only. Run python -m services.whatsapp_worker --workspace main.
# 'embedded' is an explicit local-development compatibility option only.
WHATSAPP_WORKER_MODE=external
WHATSAPP_SENDS_PER_SECOND=5
WHATSAPP_OUTAGE_RECIPIENTS=3
WHATSAPP_OUTAGE_WINDOW_SECONDS=60
WHATSAPP_OUTAGE_PAUSE_SECONDS=30
# All senders for a business number MUST use the same control database.
# PostgreSQL uses its dedicated whatsapp_dispatch schema (provision explicitly).
# WHATSAPP_DISPATCH_DATABASE_URL=postgresql+psycopg://<user>:<password>@<server>:5432/postgres?sslmode=require
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_TEST_RECIPIENT=
WHATSAPP_TEST_PARAMETER_1=Test
WHATSAPP_TEST_PARAMETER_2=Tuesday, 14 October at 10:20 AM
WHATSAPP_TEST_QUICK_REPLY_PAYLOAD=help

# Azure OpenAI scheduling assistant (optional). The deployment must support
# structured JSON output. Keep the actual key in .env and never commit it.
AZURE_OPENAI_ENDPOINT=https://<your-resource-name>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
# Optional: use the full Azure Responses API target URI supplied by the deployment.
AZURE_OPENAI_RESPONSES_URL=

# Zoho Creator OAuth client created in the India data centre
ZOHO_CREATOR_CLIENT_ID=
ZOHO_CREATOR_CLIENT_SECRET=
# Created automatically after the first approved Zoho connection. Keep secret.
ZOHO_CREATOR_REFRESH_TOKEN=

# These defaults already match the shared Creator application. Keep them unless
# the app, form, or report is renamed.
ZOHO_CREATOR_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_CREATOR_API_URL=https://www.zohoapis.in
ZOHO_CREATOR_REDIRECT_URI=http://127.0.0.1:8765/oauth/zoho/callback
ZOHO_CREATOR_ACCOUNT_OWNER=christina.sunil_turnb
ZOHO_CREATOR_APP_LINK_NAME=therapy-scheduler
ZOHO_CREATOR_FORM_LINK_NAME=All_Therapy_Schedules
ZOHO_CREATOR_REPORT_LINK_NAME=All_Therapy_Schedules_Report
ZOHO_CREATOR_PLAN_DETAIL_REPORT_LINK_NAME=Plan_Detail_Report

# The configured form has these native plain-text field link names.
ZOHO_CREATOR_FIELD_APPOINTMENT_ID=Appointment_ID
ZOHO_CREATOR_FIELD_PATIENT=Patient
ZOHO_CREATOR_FIELD_THERAPIST=Therapist
ZOHO_CREATOR_FIELD_THERAPY_TYPE=Therapy_Type
ZOHO_CREATOR_FIELD_BRANCH=Branch
ZOHO_CREATOR_FIELD_THERAPY_PLAN=Therapy_Plan
ZOHO_CREATOR_FIELD_APPOINTMENT_DATE=Appointment_Date
ZOHO_CREATOR_FIELD_START_TIME=Start
ZOHO_CREATOR_FIELD_END_TIME=End_Time
ZOHO_CREATOR_FIELD_DURATION_MINUTES=Duration_Minutes
ZOHO_CREATOR_FIELD_STATUS=Status
ZOHO_CREATOR_FIELD_NOTES=Notes

# Full daily operations in the main / UI. The --test-data launcher selects the
# existing test store and its Azure sender; genuine main data needs reviewed setup.
MAIN_WORKFLOW_ENABLED=false
# Real data always requires the operations key. Test data may opt out at /.
MAIN_WORKFLOW_REQUIRE_ACCESS_KEY=false
MAIN_WORKFLOW_LIVE=false
# main: prepared normal database; test: existing test schema/file without seeding.
MAIN_WORKFLOW_DATA_SOURCE=main
# Optional existing test-store override; never put credentials in this example.
MAIN_WORKFLOW_TEST_DATABASE_URL=
MAIN_WORKFLOW_TEST_DATABASE_SCHEMA=
MAIN_WORKFLOW_ADMIN_TOKEN=
MAIN_WORKFLOW_ADMIN_ID=
MAIN_WORKFLOW_ZOHO_OWNER=
MAIN_WORKFLOW_ZOHO_APP=
MAIN_WORKFLOW_ZOHO_PLAN_REPORT=
MAIN_WORKFLOW_ZOHO_CONSULTANT_REPORT=
# Set the real report link name to join Phone by registration ID. All three
# source reports are reread on each sync so edits work without Modified_Time.
MAIN_WORKFLOW_ZOHO_REGISTRATION_REPORT=
# Thanal structured daily sync: set owner=thanal, app=eic, plan report=
# All_Therapy_Schedule_Plans, consultant report=All_Consultants, registration
# report=All_Registrations on BOTH the app and daily job. This exact contract
# selects complete snapshots and restricts plans to the approved Calicut branch.
# Optional equivalent for the isolated test source; blank keeps its legacy input.
FLOW_TEST_ZOHO_REGISTRATION_REPORT=
MAIN_WORKFLOW_ZOHO_SCHEDULE_FORM=
MAIN_WORKFLOW_ZOHO_SCHEDULE_REPORT=
# Set only after verifying both source timestamp fields really use this zone.
MAIN_WORKFLOW_SOURCE_TIMEZONE=
# Production template with four numbered variables and Yes then No buttons.
# Keep MAIN_WORKFLOW_LIVE=false until sending is explicitly approved.
MAIN_WORKFLOW_MESSAGE_MODE=template
MAIN_WORKFLOW_TEMPLATE_PROFILE=therapy_schedule_v1
MAIN_WORKFLOW_TEMPLATE_NAME=eic_whatsapp_scheduler
MAIN_WORKFLOW_TEMPLATE_LANGUAGE=en
# Saved tomorrow offers wait until 09:00 IST; unanswered sent offers get one
# reminder from 14:00 IST. This flag does not generate/save a midnight draft.
MAIN_WORKFLOW_TIMED_TEMPLATE_ENABLED=false
# Main --test-data uses the FLOW_TEST transport configuration on its sender.
FLOW_TEST_TEMPLATE_PROFILE=legacy
FLOW_TEST_TIMED_TEMPLATE_ENABLED=false
# Optional main-only OAuth credentials; no flow_test/.env fallback is used.
MAIN_WORKFLOW_ZOHO_CLIENT_ID=
MAIN_WORKFLOW_ZOHO_CLIENT_SECRET=
MAIN_WORKFLOW_ZOHO_REFRESH_TOKEN=

# Conservative unique-parent offer budget; verify the actual Meta allowance.
# Excess offers wait for staff review; acknowledgment replies retain their lane.
WHATSAPP_UNIQUE_PARENTS_PER_24H=2000
# Optional shared PostgreSQL URL for Zoho pacing; otherwise uses the app database.
# All replicas/CLI integration workers must share that database and schema.
# ZOHO_BUDGET_DATABASE_URL=
# SQLite-only fallback: a shared durable path is required across multiple hosts.
# ZOHO_CALL_BUDGET_FILE=
